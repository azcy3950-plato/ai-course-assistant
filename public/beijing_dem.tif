<div class="fudong">
    <a href="javascript:void(0);" id="btop">
        <img src="/tadmin/media/images/btop.png" alt="">
    </a>
</div>
<script>
    $(function () {
        $("#btop").click(function () {$("html,body").animate({'scrollTop': '0px'}, 300)});
        var daohangHeight = $(".fudong").offset().top - $(window).scrollTop();
        $(window).scroll(function () {if ($(this).scrollTop() > daohangHeight) {$('.fudong').addClass('new_side_show');} else {$('.fudong').removeClass('new_side_show')}});

        $("#langSel").change(function(){
            var selectedLang =  "zh_CN";var unSelectedLang =  "en_US";if($(this).find("option:selected").text()=="English"){selectedLang = "en_US";unSelectedLang = "zh_CN";}
            Cookies.set('lang', selectedLang, { expires: 31, path: '/' });
            if(window.location.href.indexOf("lang=")>0) {window.location = window.location.href.replace(unSelectedLang, selectedLang);}else{window.location.reload();}
        });
    })
</script>

