# PostgreSQL 16+ with the pgvector extension installed.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME

# Generate a long, random value for production. Never commit the real value.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# AI and embedding providers.
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY

# Public source used to synchronize the authoritative course knowledge graph.
KNOWLEDGE_GRAPH_SOURCE_URL=https://vanitasbean.github.io/knowledge-map/index_static.html

# Aliyun OSS. Leave blank only when file storage is not used.
OSS_ACCESS_KEY=YOUR_OSS_ACCESS_KEY
OSS_SECRET_KEY=YOUR_OSS_SECRET_KEY
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=YOUR_OSS_BUCKET

# Optional Supabase client configuration.
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional maintenance-script settings.
PROCESS_API_URL=http://localhost:3000/api/process-file
PROCESS_FILE_TOKEN=YOUR_INTERNAL_PROCESS_TOKEN
OSS_PUBLIC_BASE_URL=https://YOUR_BUCKET.oss-cn-beijing.aliyuncs.com
PROCESS_SINCE=2026-01-01
SEED_API_URL=http://localhost:3000/api/agent
SEED_API_TOKEN=YOUR_INTERNAL_SEED_TOKEN
